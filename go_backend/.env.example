# Local MongoDB (install MongoDB Community locally)
# MONGODB_URI=mongodb://localhost:27017/get-organized

# MongoDB Atlas (Cloud - Recommended for production)
# Sign up at https://www.mongodb.com/cloud/atlas (free tier available)
# Replace with your connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/get-organized?retryWrites=true&w=majority

PORT=3000
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRY=15m
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
